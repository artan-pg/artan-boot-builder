<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>ir.artanpg.boot</groupId>
	<artifactId>artan-boot-builder</artifactId>
	<version>0.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>artan-boot-builder</name>
	<description>
		Artan Boot helps you to create Spring-Boot-powered, production-grade applications and services with absolute
		minimum fuss.
	</description>
	<url>https://artanpg.ir/</url>

	<developers>
		<developer>
			<name>Mohammad Yazdian</name>
			<email>m.yazdian70@outlook.com</email>
			<roles>
				<role>Leader</role>
				<role>Programmer</role>
			</roles>
			<timezone>+3:30</timezone>
		</developer>
	</developers>

	<scm>
		<url>https://github.com/artan-pg/artan-boot-builder</url>
		<connection>scm:git:https://github.com/artan-pg/artan-boot-builder.git</connection>
		<developerConnection>scm:git:https://github.com/artan-pg/artan-boot-builder.git</developerConnection>
		<tag>${project.version}</tag>
	</scm>

	<issueManagement>
		<url>https://github.com/artan-pg/artan-boot-builder/issues</url>
		<system>GitHub</system>
	</issueManagement>

	<build>
		<defaultGoal>clean compile package</defaultGoal>
	</build>

	<modules>
		<module>core</module>
		<module>platform</module>
		<module>starter</module>
	</modules>
</project>
